# Gong-NG first-boot configuration.
# Copy to the SD card boot partition as gong-firstboot.toml and edit.
# Consumed by firstrun.sh / the deferred installer, then deleted (secrets).

[unit]
hostname = "dhammagong"
timezone = "Asia/Kolkata"
admin_pin = "4321"            # initial UI PIN — change per unit!

[wifi]
# station = join an existing LAN (apt + admin from that network)
# ap      = centre access point 192.168.5.1 (SSID below)
mode = "station"
ssid = "YourWifiSsid"
passphrase = "ChangeMe"
country = "IN"
channel = 6                   # used only when mode = "ap"

[relay]
enabled_hw = true
gpio = 17
active_low = true

[rtc]
enabled = false               # true when a DS3231 is fitted
